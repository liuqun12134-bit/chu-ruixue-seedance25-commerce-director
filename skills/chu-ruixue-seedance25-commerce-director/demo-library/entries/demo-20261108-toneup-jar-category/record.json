        }
      ],
      "start_conditions": [
        "罐稳放在已有台面",
        "操作手空闲，受试手背可接近"
      ],
      "action": "指腹落入桌上开罐的膏面，随后抬离；同一操作手触到另一手背，留下可见白色膏团。两手随后开始接触推开。",
      "transition": "先完成接触转移，再举起手背；罐留在台面。",
      "end_state": "膏团位于实际接触处，指腹保留合理残留。",
      "expected_effect": "明确展示从罐到指腹再到手背的转移。",
      "avoid": [
        "不隔空出现膏团",
        "不从盖上取用却写成从罐内取用",
        "不规定来源膏量为所有产品标准用量"
      ],
      "prompt_fragment": "让开罐稳放在已有台面，用指腹取适量膏体，再把同一指腹移到另一手背接触落膏；膏团出现后再开始推开。"
    },
    {
