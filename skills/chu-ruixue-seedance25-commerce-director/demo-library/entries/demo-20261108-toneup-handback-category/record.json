      "start_conditions": [
        "罐能由受试手稳握且罐口不向下",
        "手背试用区可见且不影响持物"
      ],
      "action": "手掌继续握着圆罐，手背朝上；另一手将手背几处膏痕短程推匀。抬高手背时罐仍在同手中，没有释放该手。",
      "transition": "维持握持再略抬手背展示，不让试涂变成换手或抛罐。",
      "end_state": "同手持罐与手背薄层同时可见。",
      "expected_effect": "展示手背铺展，也保留持品关系。",
      "avoid": [
        "不把膏体抹到罐壁",
        "不让持罐手伸展成完全张掌",
        "不称为已验证乳化"
      ],
      "prompt_fragment": "在握持可靠的前提下，让持罐手露出手背，用另一手推开已有试样；始终保留真实握罐接触和罐口朝向。"
    },
