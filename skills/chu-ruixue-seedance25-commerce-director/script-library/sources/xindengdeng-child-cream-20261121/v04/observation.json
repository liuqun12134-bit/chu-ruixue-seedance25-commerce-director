  "asr": [
    {
      "start": 0.08,
      "end": 2.64,
      "text": "感觉今天店铺有点母庸专场的意思啊"
    },
    {
      "start": 2.64,
      "end": 5.08,
      "text": "儿童面霜店卖了一万多瓶"
    },
    {
      "start": 5.08,
      "end": 7.48,
      "text": "还好我下了三万单 够大家用的"
    },
    {
      "start": 7.48,
      "end": 11.48,
      "text": "然后呢 再给大家上一下这个三合一的儿童的喜户"
    },
    {
      "start": 11.48,
      "end": 13.68,
      "text": "这个是安保户的 是安安的牌子"
    },
    {
      "start": 13.68,
      "end": 16.08,
      "text": "大家可以放心牌 我都给自己孩子做的"
    },
    {
      "start": 16.08,
      "end": 19.08,
      "text": "就因为在外面买不到 我觉得安心的东西"
    },
    {
      "start": 19.08,
      "end": 21.08,
      "text": "我觉得我自己去做的话 自己心里有数"
    },
    {
      "start": 21.08,
      "end": 24.48,
      "text": "用的这个 比如说大部分产品用的一页的工厂"
    },
    {
      "start": 24.48,
      "end": 26.88,
      "text": "一页工厂的话 就是一页子大家知道的"
    },
    {
      "start": 26.88,
      "end": 29.88,
      "text": "韩数大家知道的 儿童品牌就一页 红色小上"
    },
    {
      "start": 29.88,
      "end": 32.44,
      "text": "这个一夜的一个面霜都上百块钱"
    },
    {
      "start": 32.44,
      "end": 35.2,
      "text": "工厂的话也是大力支持咱们"
    },
    {
      "start": 35.2,
      "end": 37.6,
      "text": "所以我本来是给大家当服务的价钱"
    },
    {
      "start": 37.6,
      "end": 39.0,
      "text": "做儿童的东西"
    },
    {
      "start": 39.36,
      "end": 40.32,
      "text": "成人也都能用"
    },
    {
      "start": 40.32,
      "end": 41.32,
      "text": "牛顺小孩用的东西"
    },
    {
      "start": 41.32,
      "end": 42.52,
      "text": "咱们都是小军队的"
    },
    {
      "start": 43.12,
      "end": 45.36,
      "text": "做这个独立的做了半年多的时间"
    },
    {
      "start": 48.9,
      "end": 50.74,
      "text": "然后你们牛顺小孩能用的"
    },
    {
      "start": 50.74,
      "end": 52.82,
      "text": "大人十来岁孩子就不用担心了"
    },
    {
      "start": 52.82,
      "end": 53.46,
      "text": "大人也能用"
    },
    {
      "start": 53.46,
      "end": 53.98,
      "text": "好"
    },
    {
      "start": 53.98,
      "end": 55.1,
      "text": "好了 拜拜"
    },
    {
      "start": 56.26,
      "end": 57.82,
      "text": "我们要去玩了"
    }
