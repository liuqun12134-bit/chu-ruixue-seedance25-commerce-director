  "asr": [
    {
      "start": 0.5,
      "end": 2.5,
      "text": "新等能跟大家見面了"
    },
    {
      "start": 2.5,
      "end": 5.5,
      "text": "新等能整個就做了一個產品"
    },
    {
      "start": 5.5,
      "end": 6.5,
      "text": "這個"
    },
    {
      "start": 6.5,
      "end": 10.5,
      "text": "是按照就是平時給你們買那個小央商的品牌"
    },
    {
      "start": 10.5,
      "end": 12.5,
      "text": "一個時候面霜你要花多少千塊錢"
    },
    {
      "start": 12.5,
      "end": 14.5,
      "text": "就是大幾百塊錢"
    },
    {
      "start": 14.5,
      "end": 18.5,
      "text": "我們這裡邊的一個熱騰高的可能得很貴"
    },
    {
      "start": 18.5,
      "end": 20.5,
      "text": "所以按照那個品牌的調性"
    },
    {
      "start": 20.5,
      "end": 23.5,
      "text": "咱們去訂用的這個新等的那個牌子"
    },
    {
      "start": 23.5,
      "end": 25.5,
      "text": "然後這個面霜"
    },
    {
      "start": 25.5,
      "end": 27.5,
      "text": "就是是我目前為止的"
    },
    {
      "start": 27.5,
      "end": 29.5,
      "text": "我用過我自己最喜歡的一塊"
    },
    {
      "start": 29.5,
      "end": 31.1,
      "text": "就急润了"
    },
    {
      "start": 31.1,
      "end": 35.5,
      "text": "因为就是等着这个品牌一直不再不断的去"
    },
    {
      "start": 35.5,
      "end": 36.7,
      "text": "能够去突破"
    },
    {
      "start": 36.7,
      "end": 38.5,
      "text": "然后才放在等的这个牌子上"
    },
    {
      "start": 38.5,
      "end": 40.5,
      "text": "将来就给等了呢"
    },
    {
      "start": 40.5,
      "end": 43.1,
      "text": "品牌都提前注册了好多年了"
    },
    {
      "start": 43.1,
      "end": 48.5,
      "text": "所以现在其实注册这个RBL它已经下来了"
    },
    {
      "start": 48.5,
      "end": 49.3,
      "text": "超润"
    },
    {
      "start": 49.3,
      "end": 51.5,
      "text": "大人要用这款的话你们就掏上了"
    },
    {
      "start": 51.5,
      "end": 53.5,
      "text": "90%就是6以上的天然成分"
    },
    {
      "start": 53.5,
      "end": 54.7,
      "text": "因为不能说100%"
    },
    {
      "start": 54.7,
      "end": 55.9,
      "text": "能就弄吧"
    },
    {
      "start": 55.9,
      "end": 60.66,
      "text": "三種植物的精油加雞蟲植物精脆"
    },
    {
      "start": 61.38,
      "end": 63.42,
      "text": "還加了牛油果鍋紙"
    },
    {
      "start": 63.42,
      "end": 66.66,
      "text": "給你保濕量的不要出類的水分"
    },
    {
      "start": 66.66,
      "end": 68.82,
      "text": "小孩的身上是沒有油脂的"
    },
    {
      "start": 68.82,
      "end": 69.62,
      "text": "天生"
    },
    {
      "start": 70.38,
      "end": 71.78,
      "text": "慢慢慢慢的才出類的"
    },
    {
      "start": 71.78,
      "end": 73.78,
      "text": "所以它缺在我們給它補上"
    },
    {
      "start": 74.34,
      "end": 76.34,
      "text": "這個才是真正了解小孩的"
    },
    {
      "start": 76.58,
      "end": 79.18,
      "text": "為什麼沒有油脂就比較脆弱"
    },
    {
      "start": 79.18,
      "end": 80.74,
      "text": "像大人的臉也是一樣的"
    },
    {
      "start": 80.74,
      "end": 85.42,
      "text": "所以這邊還是要有一些適當的油脂"
    },
    {
      "start": 85.9,
      "end": 88.4,
      "text": "那這個大家需要先中午12點"
    },
    {
      "start": 88.4,
      "end": 89.4,
      "text": "中午12點"
    },
    {
      "start": 89.4,
      "end": 90.4,
      "text": "我過來"
    }
  ]
}
