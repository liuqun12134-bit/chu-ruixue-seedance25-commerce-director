    {
      "start": 0.0,
      "end": 1.8,
      "text": "所以你們都看到了我家做過的朋友們"
    },
    {
      "start": 1.8,
      "end": 3.6,
      "text": "咱們都做了幼兒系列的"
    },
    {
      "start": 3.6,
      "end": 4.28,
      "text": "對不對"
    },
    {
      "start": 4.28,
      "end": 4.6,
      "text": "對"
    },
    {
      "start": 4.6,
      "end": 6.04,
      "text": "你們買花冰有啥不安全的"
    },
    {
      "start": 6.04,
      "end": 9.04,
      "text": "大家幼兒系列的話都有一個30多款"
    },
    {
      "start": 9.04,
      "end": 10.0,
      "text": "這款是特的"
    },
    {
      "start": 10.0,
      "end": 11.4,
      "text": "這款你們看能看得到的潤"
    },
    {
      "start": 11.4,
      "end": 12.28,
      "text": "這很多人排"
    },
    {
      "start": 12.28,
      "end": 13.64,
      "text": "很多人喜歡這個真空包裝"
    },
    {
      "start": 13.64,
      "end": 14.12,
      "text": "對"
    },
    {
      "start": 14.12,
      "end": 14.88,
      "text": "真空包裝"
    },
    {
      "start": 14.88,
      "end": 16.88,
      "text": "你們都要多個看能不能自己新設計了"
    },
    {
      "start": 16.88,
      "end": 17.24,
      "text": "行嗎"
    },
    {
      "start": 17.24,
      "end": 17.72,
      "text": "好"
    },
    {
      "start": 17.72,
      "end": 19.0,
      "text": "這一次還要等著你的喜好"
    },
    {
      "start": 19.0,
      "end": 20.2,
      "text": "等著你喜歡貓咪"
    },
    {
      "start": 20.2,
      "end": 22.36,
      "text": "所以我覺得我就是我們要把"
    },
    {
      "start": 22.36,
      "end": 24.0,
      "text": "事業做成熱愛"
    },
    {
      "start": 24.0,
      "end": 26.2,
      "text": "就是我做花冰做到"
    },
    {
      "start": 26.2,
      "end": 28.0,
      "text": "從我大學畢業出來吧"
    },
    {
      "start": 28.0,
      "end": 28.72,
      "text": "然後就開始做"
    },
    {
      "start": 28.72,
      "end": 30.52,
      "text": "就有个茄子做光明"
    },
    {
      "start": 30.52,
      "end": 32.12,
      "text": "但是我心里我姑娘是粉"
    },
    {
      "start": 32.12,
      "end": 34.08,
      "text": "但是小女孩儿得做粉菜"
    },
    {
      "start": 34.08,
      "end": 34.68,
      "text": "然后呢这个"
    },
    {
      "start": 34.68,
      "end": 35.96,
      "text": "大家知道那个小丁的那个面霜"
    },
    {
      "start": 35.96,
      "end": 37.56,
      "text": "一个面霜大概是七百块钱"
    },
    {
      "start": 37.56,
      "end": 38.2,
      "text": "是啊"
    },
    {
      "start": 38.2,
      "end": 40.16,
      "text": "那这我刚才也用这个"
    },
    {
      "start": 40.16,
      "end": 41.44,
      "text": "然后这个挺好用的"
    },
    {
      "start": 41.44,
      "end": 43.0,
      "text": "但是它那个味儿得香"
    },
    {
      "start": 43.0,
      "end": 44.8,
      "text": "然后我就不敢用那个国际的那个"
    },
    {
      "start": 44.8,
      "end": 46.64,
      "text": "就是刚刚肯定想给我好了嘛"
    },
    {
      "start": 46.64,
      "end": 47.64,
      "text": "七百块钱一个"
    },
    {
      "start": 47.64,
      "end": 48.72,
      "text": "你带那个"
    },
    {
      "start": 48.72,
      "end": 50.16,
      "text": "就好的商量的肉"
    },
    {
      "start": 50.16,
      "end": 50.72,
      "text": "后来我就说"
    },
    {
      "start": 50.72,
      "end": 53.04,
      "text": "我就找那个做凌果式那个工厂"
    },
    {
      "start": 53.04,
      "end": 54.04,
      "text": "那凌果式"
    },
    {
      "start": 54.04,
      "end": 55.48,
      "text": "这个冰糖"
    },
    {
      "start": 55.48,
      "end": 55.92,
      "text": "对"
    },
    {
      "start": 55.92,
      "end": 57.88,
      "text": "然后这是咱做咱们家的"
    },
    {
      "start": 57.88,
      "end": 61.44,
      "text": "他说英雄我他英雄的做那个林博士的"
    },
    {
      "start": 61.44,
      "end": 62.88,
      "text": "我说能不能帮我做个"
    },
    {
      "start": 63.44,
      "end": 64.96,
      "text": "幽儿的给我自己工人用一个"
    },
    {
      "start": 64.96,
      "end": 67.48,
      "text": "但是就是就是非常没有安全的"
    },
    {
      "start": 67.72,
      "end": 68.28,
      "text": "所以法律"
    },
    {
      "start": 68.28,
      "end": 69.44,
      "text": "按照国家法律法规"
    },
    {
      "start": 69.6,
      "end": 70.88,
      "text": "哎又又好就安全"
    },
    {
      "start": 70.88,
      "end": 72.64,
      "text": "然后你再认的话你继续路"
    },
    {
      "start": 72.72,
      "end": 73.4,
      "text": "拉到顶"
    },
    {
      "start": 73.68,
      "end": 75.04,
      "text": "然后这种东西都拿着真多高桌"
